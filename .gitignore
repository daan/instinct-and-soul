*.swp
.DS_Store
__pycache__/

# Per-creature session logs — contain interaction data + Claude reflections.
creatures/*/logs/
sim_creatures/*/logs/

# Simulator inputs (mocap-derived .npz, synthetic test data) — not under git.
# Keep small test fixtures in tests/ if needed.
sim_in/

# Network profiles — contain WiFi credentials. Only example.toml is checked in.
.config/networks/*.toml
!.config/networks/example.toml

# Main config + LLM profiles — contain API keys. Only example.toml and
# *.example.toml templates are checked in.
.config/config.toml
.config/llm/*.toml
!.config/llm/example.toml
!.config/llm/*.example.toml

