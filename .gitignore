*.swp
.DS_Store
__pycache__/

# Per-creature session logs — contain interaction data + Claude reflections.
# ** matches any depth so logs under experiment subfolders (e.g.
# sim_creatures/lala_repeated/<creature>/logs/) are ignored too.
creatures/**/logs/
sim_creatures/**/logs/

test/organ/output/*
test/organ/study/*
tune*.log
boot-watch-*log


# Simulator run output (captured sessions: imu/audio/midi/display + baked trace.json).
sim_out/

# Simulator inputs (mocap-derived .npz, synthetic test data) — not under git.
# Keep small test fixtures in tests/ if needed.
sim_in/

# Mocap source + baked output (AMASS-licensed raw .npz, large generated JSON).
# The pipeline lives in src/instinct_and_soul/mocaplib; the data does not ship.
data/mocap/

# Network profiles — contain WiFi credentials. Only example.toml is checked in.
.config/networks/*.toml
!.config/networks/example.toml

# Main config + LLM profiles — contain API keys. Only example.toml and
# *.example.toml templates are checked in.
.config/config.toml
.config/llm/*.toml
!.config/llm/example.toml
!.config/llm/*.example.toml


# Rendered performance videos (generated).
data/mocap/renders/

# Local MIDI soundfonts (.sf2) for bake-midi — large binaries, fetch your own.
soundfonts/
